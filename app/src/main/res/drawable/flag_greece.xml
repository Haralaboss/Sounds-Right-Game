<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="27dp"
    android:height="18dp"
    android:viewportWidth="27"
    android:viewportHeight="18">
    <!-- White background -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0h27v18H0z"/>
    <!-- Blue stripes -->
    <!-- Greek flag has 9 stripes: 5 blue, 4 white. Stripe height is 2. -->
    <path
        android:fillColor="#0D5EAF"
        android:pathData="M0,0h27v2H0z M0,4h27v2H0z M0,8h27v2H0z M0,12h27v2H0z M0,16h27v2H0z"/>
    <!-- Canton (10x10 blue area in top-left) -->
    <!-- The canton has 5 stripes height, which is 10 units high. Width is 10 units. -->
    <path
        android:fillColor="#0D5EAF"
        android:pathData="M0,0h10v10H0z"/>
    <!-- White cross in canton -->
    <!-- Cross bars are 2 units wide (the height/width of one stripe) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4,0h2v10H4z M0,4h10v2H0z"/>
</vector>
